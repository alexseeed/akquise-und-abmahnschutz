# Schlüssel selbst hier eintragen (Texteditor), nie in einen Chat kopieren.
# ---- Pflicht ---------------------------------------------------------
SKAEL_API_KEY=eak_dein_key_hier
OPENAI_API_KEY=sk-dein_key_hier

# ---- Optional --------------------------------------------------------
# Findymail: zweiter Mailfinder für Geschäftsführer, nur wenn Skael nichts findet.
# Eigenes Abo (app.findymail.com → API). Restguthaben zeigt der Befehl `doctor`.
FINDYMAIL_API_KEY=

# ---- Modelle (Clay-Defaults aus „Vorlage | ECOM 2.0“) ----------------
OPENAI_MODEL_DEFAULT=gpt-4o-mini
# Domain-Suche: Clay nutzt einen Claygent mit gemini-2.5-flash-lite,
# hier der Skael-Rechercheagent mit demselben Modell
DOMAIN_AGENT_MODEL=google/gemini-2.5-flash-lite
DOMAIN_AGENT_MAX_STEPS=5

# ---- Traffic-Filter (Clay Import: MIN AVR TRAFFIC / MIN AVR H T 3 MO / MODE AND/OR) ----
# Standard = Clay: ein Shop wird angereichert, sobald SimilarWeb überhaupt Besuche misst.
MIN_AVR_TRAFFIC=1
MIN_MAX_TRAFFIC_3MO=1
TRAFFIC_MODE=OR

# ---- Durchsatz -------------------------------------------------------
SKAEL_RATE_LIMIT_PER_SEC=5
OPENAI_RATE_LIMIT_PER_SEC=2
MAX_CONCURRENCY=5
HTTP_TIMEOUT=180
MAX_RETRIES=4
BODYTEXT_MAX_CHARS=8192
ICP_BODYTEXT_MAX_CHARS=200000

# ---- Feature-Schalter ------------------------------------------------
USE_FINDYMAIL=true
DO_PERSONALISIERUNG=true
DO_VIDEO_TITLE=true

# ---- Community-Sperrliste ------------------------------------------
# OWNER ist ein Platzhalter: Der Betreiber des Pakets ersetzt ihn beim Einrichten durch sein GitHub-Konto.
# Steht er noch da, zeigt `python3 -m ecom doctor` ✗ und der Export bricht ab. Adresse beim Betreiber
# erfragen und hier eintragen – die Pflicht nicht abschalten.
SPERRLISTE_URL=https://raw.githubusercontent.com/alexseeed/werbemail-sperrliste/main/data/sperrliste.txt
# true = ohne geladene Liste kein Export
SPERRLISTE_PFLICHT=true

# ---- Ablage ----------------------------------------------------------
DB_PATH=data/shops.db
