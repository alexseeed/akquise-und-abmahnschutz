# Zugänge für den Amazon-Pfad. Diese Datei als ".env" kopieren und die Werte eintragen:
#   cp .env.example .env
# Die .env wird nie weitergegeben (steht in .gitignore). Schlüssel nie in Chats oder Screenshots.

# Pflicht: Oxylabs Web Scraper API (https://oxylabs.io) – Benutzername und Passwort des API-Nutzers
OXYLABS_USER=
OXYLABS_PASS=

# Bright Data (https://brightdata.com) – nötig für E-Mail und Telefon: Kontaktdaten der fertigen Leads (auch Register)
BRIGHTDATA_TOKEN=

# Skael (https://skael.de) – Pflicht, wenn per E-Mail angeschrieben wird: prüft die Zustellbarkeit jeder Adresse.
# Dazu Website, Impressum, Geschäftsführung und Anrede (nur DE/AT/CH).
SKAEL_API_KEY=
