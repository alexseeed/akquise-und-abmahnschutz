# Beispielkampagne: Architekturbüros DACH (Oktober 2026)
# Prompts liegen in prompts/, Datenbank und Exporte entstehen in data/ und exports/.

# ---- Zielgruppe / Suche -----------------------------------------------
# Suchbegriffe, Länder und Ortsgröße werden mit `init` gesetzt:
#   python3 -m scraper --kampagne beispiel-architekturbueros init \
#     --keywords "Architekturbüro,Architekt" --countries DE,AT,CH --min-population 50000
EXCLUDED_TLDS=.fr,.nl,.it

# ---- KI ------------------------------------------------------------------
# Einordnung bei "unklar" — muss im enum von prompts/pain_kategorie.schema.json stehen
KATEGORIE_NORMALFALL=Projekte

# ---- Domainsuche für Firmen ohne Website: skael | openai | aus ----------------
DOMAINSUCHE=aus

# ---- Mailabsatz (Export-Spalte "Absatz Beobachtung") --------------------------
ABSATZ_EINLEITUNG=Beim Blick auf Ihre Website ist mir aufgefallen,
ABSATZ_FOLGESATZ=Gleichzeitig hatte ich den Eindruck, dass Sie sich bei der Gewinnung passender Projekte und qualifizierter Fachkräfte noch stark auf Empfehlungen und Ihr Netzwerk verlassen.
ABSATZ_STANDARD=Beim Blick auf Ihren Außenauftritt hatte ich direkt den Eindruck, dass Sie sich bei der Gewinnung passender Projekte und qualifizierter Fachkräfte noch stark auf Empfehlungen und Ihr Netzwerk verlassen.

# ---- Versand ---------------------------------------------------------------
DO_PERSONALISIERUNG=true
DO_VIDEO_TITLE=true
