# Kampagne: [[Name der Kampagne, z. B. Steuerberater Bayern Q1]]
# Diese Datei überschreibt die .env im Projektordner. Zugangsschlüssel gehören NICHT hierher.

# ---- Zielgruppe / Suche -----------------------------------------------
# Suchbegriffe, Länder und Ortsgröße werden mit `init` gesetzt, z. B.:
#   python3 -m scraper --kampagne <name> init --keywords "Begriff 1,Begriff 2" --countries DE,AT,CH --min-population 50000
# Bei Kampagnen in Frankreich, den Niederlanden oder Italien leeren, sonst fällt die Zielgruppe raus:
EXCLUDED_TLDS=.fr,.nl,.it

# ---- KI ------------------------------------------------------------------
# Kategorie bei "unklar" — muss im enum von prompts/pain_kategorie.schema.json stehen
KATEGORIE_NORMALFALL=[[Normalfall-Kategorie]]
# Optional anderes Modell nur für diese Kampagne:
# MODEL_PERSONALISIERUNG=skael/smart

# ---- Domainsuche für Firmen ohne Website: skael | openai | aus ----------------
# aus = günstigste Variante; Firmen ohne Website lassen sich ohnehin schlecht prüfen
DOMAINSUCHE=aus

# ---- Mailabsatz (Export-Spalte "Absatz Beobachtung") --------------------------
# Der Einstiegssatz wird zwischen EINLEITUNG und FOLGESATZ gesetzt. Findet die KI kein
# konkretes Detail, steht in der Spalte ABSATZ_STANDARD. Leer lassen = Spalte enthält nur den Satz.
ABSATZ_EINLEITUNG=[[z. B. Beim Blick auf Ihre Website ist mir aufgefallen,]]
ABSATZ_FOLGESATZ=[[Satz, der zum Problem überleitet]]
ABSATZ_STANDARD=[[Absatz ohne Personalisierung, für Firmen mit dünner Website]]

# ---- Versand ---------------------------------------------------------------
DO_PERSONALISIERUNG=true
DO_VIDEO_TITLE=[[true, wenn mit persönlichem Video angeschrieben wird]]
