# ---- Pflicht ---------------------------------------------------------
SKAEL_API_KEY=eak_dein_key_hier
OPENAI_API_KEY=sk-dein_key_hier

# ---- Optional --------------------------------------------------------
# Findymail: zweiter Mailfinder für Geschäftsführer, nur wenn Skael nichts findet.
# Eigenes Abo (app.findymail.com → API). Restguthaben zeigt der Befehl `doctor`.
FINDYMAIL_API_KEY=

# ---- Modelle (Clay-Defaults) ----------------------------------------
OPENAI_MODEL_DOMAIN=gpt-4.1-mini
OPENAI_MODEL_DEFAULT=gpt-4o-mini

# ---- Durchsatz -------------------------------------------------------
SKAEL_RATE_LIMIT_PER_SEC=5
OPENAI_RATE_LIMIT_PER_SEC=2
MAX_CONCURRENCY=5
HTTP_TIMEOUT=180
MAX_RETRIES=4

# ---- Prozess-Parameter (Clay-Defaults) -------------------------------
CITIES_LIMIT=5000
MAPS_ZOOM=11
MAPS_LIMIT=2000
BODYTEXT_MAX_CHARS=8192

# ---- Zielgruppen-Filter ----------------------------------------------
# TLDs, die komplett aussortiert werden (Clay-Original: DACH-Kampagne).
# Beim Scrapen von FR/NL/IT unbedingt leeren:  EXCLUDED_TLDS=
EXCLUDED_TLDS=.fr,.nl,.it

# ---- Feature-Schalter (entsprechen den Clay-ON/OFF-Spalten) ----------
QUALI_ON=true
SEND_ON=true
USE_FINDYMAIL=true
DO_PERSONALISIERUNG=true
DO_VIDEO_TITLE=true
DO_LINKEDIN=false

# ---- Community-Sperrliste ------------------------------------------
# Domains, die nach einer Abmahnung wegen Werbe-E-Mails gemeldet wurden.
# Der Export sortiert diese Firmen automatisch aus (Datei 5_gesperrt_…csv).
SPERRLISTE_URL=https://raw.githubusercontent.com/alexseeed/werbemail-sperrliste/main/data/sperrliste.txt
# true = ohne geladene Liste kein Export
SPERRLISTE_PFLICHT=true

# ---- Ablage ----------------------------------------------------------
DB_PATH=data/leads.db
