# .env im Projektordner: Zugangsschlüssel und Standardwerte für alle Kampagnen.
# Alles Zielgruppenspezifische gehört nach kampagnen/<name>/kampagne.env.

# ---- Pflicht ---------------------------------------------------------
SKAEL_API_KEY=eak_dein_key_hier

# ---- KI-Anbieter: skael (Standard) | openai --------------------------
# skael: läuft über Skael-Credits, keine ChatGPT-Rate-Limits. Der Skael-Schlüssel braucht
#        die Fähigkeit llm:invoke (in der Beta bei Skael anfragen). `doctor` prüft das.
# openai: direkt bei OpenAI, dann OPENAI_API_KEY setzen.
LLM_PROVIDER=skael
# Optional eigener Skael-Schlüssel nur für die KI (mit llm:invoke). Schlüssel mit Fähigkeiten haben
# ein Tageslimit (Standard 5.000 Credits ≈ 1.000–1.200 Leads) — beim Anlegen höher setzen lassen.
SKAEL_LLM_API_KEY=

# Modelle für den gewählten Anbieter (leer = Standard)
#   skael:  MODEL_DEFAULT=skael/fast       MODEL_PERSONALISIERUNG=skael/smart
#   openai: MODEL_DEFAULT=gpt-4o-mini      MODEL_PERSONALISIERUNG=gpt-4.1
MODEL_DEFAULT=
MODEL_PERSONALISIERUNG=

# ---- Optional: OpenAI ------------------------------------------------
# Nur nötig bei LLM_PROVIDER=openai oder DOMAINSUCHE=openai
OPENAI_API_KEY=
# Ersatzschlüssel, greift automatisch, wenn der Hauptschlüssel sein Guthaben/Limit erreicht
OPENAI_API_KEY_FALLBACK=
OPENAI_MODEL_DOMAIN=gpt-4.1-mini

# ---- Optional: zweiter E-Mail-Finder ---------------------------------
# Findymail: nur für Geschäftsführer, nur wenn Skael nichts findet.
# Eigenes Abo (app.findymail.com → API). Restguthaben zeigt der Befehl `doctor`.
FINDYMAIL_API_KEY=
USE_FINDYMAIL=false

# ---- Standard-Kampagne (sonst: --kampagne <name> bei jedem Aufruf) ----
KAMPAGNE=

# ---- Domainsuche für Firmen ohne Website: skael | openai | aus -------
# aus (Standard): Firmen ohne Website fallen raus — günstig, solche Firmen sind kaum prüfbar
# skael:  über das Impressum bestätigt, 15–35 Credits je Firma, findet nur Belegtes
#         (Test: "spreeformat architekten" nicht gefunden, 35 Credits)
# openai: Websuche, ca. 1 Cent je Firma, findet mehr, rät aber auch — bei vielen Firmen teuer
DOMAINSUCHE=aus

# ---- Durchsatz -------------------------------------------------------
SKAEL_RATE_LIMIT_PER_SEC=20
OPENAI_RATE_LIMIT_PER_SEC=2
MAX_CONCURRENCY=12
HTTP_TIMEOUT=180
# Höchstwartezeit je asynchronem Skael-Auftrag (Sekunden); danach wird die Zeile später erneut versucht
SKAEL_MAX_WARTEZEIT=900
MAX_RETRIES=4

# ---- Prozess-Parameter (Clay-Defaults) -------------------------------
CITIES_LIMIT=5000
MAPS_ZOOM=11
MAPS_LIMIT=2000
BODYTEXT_MAX_CHARS=8192

# ---- Feature-Schalter (entsprechen den Clay-ON/OFF-Spalten) ----------
QUALI_ON=true
SEND_ON=true
DO_PERSONALISIERUNG=true
DO_VIDEO_TITLE=true
DO_LINKEDIN=false

# ---- Community-Sperrliste ------------------------------------------
# Domains, die nach einer Abmahnung wegen Werbe-E-Mails gemeldet wurden.
# Der Export sortiert diese Firmen automatisch aus (Datei 5_gesperrt_…csv).
SPERRLISTE_URL=https://raw.githubusercontent.com/alexseeed/werbemail-sperrliste/main/data/sperrliste.txt
# true = ohne geladene Liste kein Export. Steht in der URL noch OWNER, ist die Liste
# nicht eingerichtet — dann bewusst false setzen.
SPERRLISTE_PFLICHT=true
