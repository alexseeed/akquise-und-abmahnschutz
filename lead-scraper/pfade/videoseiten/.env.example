# Zugänge für die Videoseiten. Kopieren nach .env und ausfüllen.
# Der Nutzer trägt die Werte selbst ein; der Agent liest diese Datei nie aus.

# Skael (persönliche Videos). Leer lassen, wenn derselbe Schlüssel schon in pfade/google-maps/.env steht.
SKAEL_API_KEY=

# Hostinger-API-Schlüssel aus dem hPanel (anleitungen/02_hostinger-vps.md)
HOSTINGER_API_TOKEN=

# Geheimnis des Skael-Webhooks (Kampagne → Webhook), danach: werkzeuge/hostinger.py geheimnis --vm <id>
SKAEL_WEBHOOK_SECRET=

# Optional: Adresse, an die jede Datenlöschung zusätzlich gemeldet wird (z. B. ein n8n- oder Make-Webhook)
MELDUNG_URL=

# Optional: Versuche je API-Aufruf bei vorübergehenden Fehlern (Standard 5)
# MAX_RETRIES=5
